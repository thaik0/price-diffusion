.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
# Research notes are local working material, not repository artifacts.
research_notes/

# Keep directory markers, but do not version generated or downloaded data.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/diagnostics/*
!outputs/diagnostics/.gitkeep

# Compact validation/intermediate tables are reproducible and remain local.
outputs/robustness/*/validation.csv
outputs/robustness/nulls/observed_vs_null_results.csv
